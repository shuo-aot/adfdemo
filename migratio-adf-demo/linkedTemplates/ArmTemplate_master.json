{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "migratio-adf-demo"
		},
		"migratiodb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'migratiodb'"
		},
		"demokv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-migratiodemo.vault.azure.net/"
		},
		"migratiodb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "20.63.101.180"
		},
		"migratiodb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "WideWorldImportersDW"
		},
		"migratiodb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "migratio-adf-demo_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"migratiodb_password": {
						"value": "[parameters('migratiodb_password')]"
					},
					"demokv_properties_typeProperties_baseUrl": {
						"value": "[parameters('demokv_properties_typeProperties_baseUrl')]"
					},
					"migratiodb_properties_typeProperties_server": {
						"value": "[parameters('migratiodb_properties_typeProperties_server')]"
					},
					"migratiodb_properties_typeProperties_database": {
						"value": "[parameters('migratiodb_properties_typeProperties_database')]"
					},
					"migratiodb_properties_typeProperties_userName": {
						"value": "[parameters('migratiodb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}