{
	"name": "DemoCopyData",
	"properties": {
		"activities": [
			{
				"name": "FindAllSourceTable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT \n    TABLE_SCHEMA AS SourceSchema,\n    TABLE_NAME AS SourceTable,\n    CONCAT(TABLE_SCHEMA, '_', TABLE_NAME) AS DestTable\nFROM INFORMATION_SCHEMA.TABLES\nWHERE TABLE_TYPE = 'BASE TABLE'\n  AND TABLE_SCHEMA IN ('schema1', 'schema2', 'schema3');",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "InformationSchema",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "LoopThroughAllTables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FindAllSourceTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FindAllSourceTable').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "MoveData",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "SqlServerSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate"
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "SourceTable",
									"type": "DatasetReference",
									"parameters": {
										"pSchema": {
											"value": "@item().SourceSchema",
											"type": "Expression"
										},
										"pTable": {
											"value": "@item().SourceTable",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "sinkDataset",
									"type": "DatasetReference",
									"parameters": {
										"pSchema": "Test",
										"pTable": {
											"value": "@item().DestTable",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"pSchema": {
				"type": "String"
			}
		},
		"annotations": []
	}
}